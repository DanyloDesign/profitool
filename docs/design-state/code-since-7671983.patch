 import { ua } from "./ua";
-import { ru } from "./ru";
+import { en } from "./en";
 
-export const locales = ["ua", "ru"] as const;
+export const locales = ["ua", "en"] as const;
 export type Locale = (typeof locales)[number];
 export const defaultLocale: Locale = "ua";
 
 export type Dict = typeof ua;
 
-const dicts: Record<Locale, Dict> = { ua, ru };
+const dicts: Record<Locale, Dict> = { ua, en };
 
 export function getDict(locale: Locale): Dict {
   return dicts[locale] ?? dicts[defaultLocale];
@@ -18,10 +18,10 @@ export function isLocale(value: string): value is Locale {
 }
 
 /** Тег для атрибута lang: украинский это uk, а не ua. */
-export const htmlLang: Record<Locale, string> = { ua: "uk", ru: "ru" };
+export const htmlLang: Record<Locale, string> = { ua: "uk", en: "en" };
 
 /** Подменяет локаль в текущем пути, сохраняя раздел и параметры. */
 export function swapLocale(pathname: string, next: Locale): string {
-  const rest = pathname.replace(/^\/(ua|ru)(?=\/|$)/, "");
+  const rest = pathname.replace(/^\/(ua|en)(?=\/|$)/, "");
   return `/${next}${rest || ""}`;
 }
diff --git a/src/i18n/plural.ts b/src/i18n/plural.ts
index 3ff0756..963c83d 100644
--- a/src/i18n/plural.ts
+++ b/src/i18n/plural.ts
@@ -1,4 +1,4 @@
-/** Слов'янські числівники: 1 позиція, 2 позиції, 5 позицій. Працює для ua і ru. */
+/** Слов'янські числівники: 1 позиція, 2 позиції, 5 позицій. */
 export function plural(n: number, forms: [string, string, string]): string {
   const mod10 = n % 10;
   const mod100 = n % 100;
@@ -6,3 +6,8 @@ export function plural(n: number, forms: [string, string, string]): string {
   if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return forms[1];
   return forms[2];
 }
+
+/** English numerals: 1 item, 2 items. */
+export function pluralEn(n: number, forms: [string, string]): string {
+  return n === 1 ? forms[0] : forms[1];
+}
